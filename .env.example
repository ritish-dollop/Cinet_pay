# ==============================================================================
# Environment Configuration Template for CinetPay Application
# Copy this file to .env and replace placeholder values with your real secrets
# ==============================================================================

# Application Image & Port
APP_IMAGE=ghcr.io/ritish-dollop/cinet-pay:latest
APP_PORT=8080

# Database Configuration
DB_NAME=cinetpay_db
DB_USERNAME=cinetuser
DB_PASSWORD=your_secure_db_password_here
DB_ROOT_PASSWORD=your_secure_root_password_here
DB_EXTERNAL_PORT=127.0.0.1:3306

# CinetPay Credentials
# Obtain these from your CinetPay Merchant Dashboard
CINETPAY_API_KEY=your_cinetpay_api_key_here
CINETPAY_API_PASSWORD=your_cinetpay_api_password_here
CINETPAY_BASE_URL=https://api.cinetpay.net

# Payment Callback URLs
CINETPAY_SUCCESS_URL=https://yourdomain.com/api/payment/success
CINETPAY_FAILED_URL=https://yourdomain.com/api/payment/failed
CINETPAY_NOTIFY_URL=https://yourdomain.com/api/payment/notify

# Optional CinetPay Settings
CINETPAY_LANG=fr
CINETPAY_DIRECT_PAY=false

# Webhook Security
# Secret key used to verify HMAC SHA256 webhook signatures
WEBHOOK_SECRET=your_webhook_secret_key_here
